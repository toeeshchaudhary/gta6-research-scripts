+    q->CancelRequestsWithTag(0xFF, 0x22);  // 0x22
+    DSTORAGE_REQUEST later = file_request(b, 0, outs[5].data(), 16, 0x11);  // enqueued after: not cancelled
+    q->EnqueueRequest(&later);
