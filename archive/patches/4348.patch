+    IDStorageQueueX2* q = make_queue(env, 0x80, false);
+    IDStorageStatusArrayX* s = make_status(env, 1);
+    std::vector<std::vector<uint8_t>> outs(6, std::vector<uint8_t>(16, 0));
+    const uint64_t tags[] = {0x11, 0x12, 0x21, 0x22, 0x31};
