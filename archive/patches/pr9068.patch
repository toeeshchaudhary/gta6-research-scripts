+    shape = buffer_view_shape(kVa + 0x100, 0x200, DXGI_FORMAT_R16_UINT);
+    raw(device, 70, word(&shape.resource), word(&shape.view), destination);
+    EXPECT(g_title_page.calls == 1 && mock->calls[18] == ++views && mock->args[18][0] == word(first) &&
