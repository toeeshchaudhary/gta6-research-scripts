+    check_hr(s->GetHResult(1), S_OK, "a cancelled request with an enqueue error is a success");
+    q->RetrieveErrorRecord(&rec);
+    check(rec.FailureCount == 0, "a cancelled request is not counted as a failure");
+
+    s->Release();
+    b->Release();
+    q->Release();
+}
