+    check(wait_complete(s, 0), "the event entries complete");
+    check(WaitForSingleObject(second, 0) == WAIT_TIMEOUT, "a closed event's reused handle value is not set");
+    DSTORAGE_ERROR_RECORD rec{};
+    q->RetrieveErrorRecord(&rec);
