+    HANDLE second = CreateEventW(nullptr, TRUE, FALSE, nullptr);  // may get the same handle value
+    q->EnqueueSetEvent(reinterpret_cast<HANDLE>(static_cast<uintptr_t>(0x7ffffff0)));  // not a handle
+    q->EnqueueSetEvent(nullptr);
