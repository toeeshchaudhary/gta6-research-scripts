+DSTORAGE_REQUEST file_request(IDStorageFileX* f, uint64_t offset, void* dst, uint32_t n, uint64_t tag = 0,
+                              const char* name = nullptr) {
+    DSTORAGE_REQUEST r{};
+    r.File = f;
+    r.FileOffset = offset;
+    r.Destination = dst;
+    r.DestinationSize = n;
+    r.SourceSize = n;
+    r.CancellationTag = tag;
+    r.Name = name;
+    return r;
+}
