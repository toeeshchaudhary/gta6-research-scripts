+// The initial state a texture is created in. The console names states out of its own numbering, so a texture is asked
+// to start in bit patterns D3D12 only allows on a buffer: the retail boot's targets arrive as 0x6 (INDEX_BUFFER |
+// RENDER_TARGET, the value both of its first two textures pass, flags 0x1 then 0x2). A state the PC rules already
+// accept is kept; one whose write bit the resource's own flags do not back is replaced by the state those flags ask
+// for: RENDER_TARGET with ALLOW_RENDER_TARGET, DEPTH_WRITE with ALLOW_DEPTH_STENCIL, UNORDERED_ACCESS with
+// ALLOW_UNORDERED_ACCESS, GENERIC_READ with ALLOW_SIMULTANEOUS_ACCESS (a shared texture has no other write state).
+// A state no flag can account for is returned unchanged, so initial_state_refusal still refuses it. Buffers take any
+// bits and are left alone.
+D3D12_RESOURCE_STATES console_initial_state(const D3D12_RESOURCE_DESC& desc, D3D12_RESOURCE_STATES state) {
+    if (desc.Dimension == D3D12_RESOURCE_DIMENSION_BUFFER) return state;
+    const UINT flags = UINT(desc.Flags);
+    const UINT s = UINT(state);
+    const UINT kept = s & kTextureStates;
+    const UINT writes = kept & kTextureWriteStates;
+    if (kept == s && !writes) return state;  // already a texture state, or no write bit
+    if (writes && !(writes & (writes - 1))) {  // exactly one write bit: it stands when its flag is set
+        if ((writes == D3D12_RESOURCE_STATE_RENDER_TARGET && (flags & D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET)) ||
+            (writes == D3D12_RESOURCE_STATE_UNORDERED_ACCESS && (flags & D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS)) ||
+            (writes == D3D12_RESOURCE_STATE_DEPTH_WRITE && (flags & D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL)))
+            return state;
+    }
+    if (flags & D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET) return D3D12_RESOURCE_STATE_RENDER_TARGET;
+    if (flags & D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL) return D3D12_RESOURCE_STATE_DEPTH_WRITE;
+    if (flags & D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS) return D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+    if (flags & D3D12_RESOURCE_FLAG_ALLOW_SIMULTANEOUS_ACCESS) return D3D12_RESOURCE_STATE_GENERIC_READ;
+    return state;
