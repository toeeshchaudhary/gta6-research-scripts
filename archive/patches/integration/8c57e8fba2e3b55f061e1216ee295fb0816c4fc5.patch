+// Copies [va, va + bytes) into `dst`, region by region: the title's placeholder is many VirtualAlloc regions, so a
+// single VirtualQuery does not cover it. A page that is not committed and readable stays zero. Returns the bytes copied.
+std::uint64_t copy_console_va(void* dst, std::uint64_t va, std::uint64_t bytes) {
+    auto* out = static_cast<std::uint8_t*>(dst);
+    std::uint64_t copied = 0;
+    for (std::uint64_t at = 0; at < bytes;) {
+        MEMORY_BASIC_INFORMATION info{};
+        const auto* address = reinterpret_cast<const void*>(static_cast<std::uintptr_t>(va + at));
+        if (VirtualQuery(address, &info, sizeof(info)) == 0) break;
+        const std::uint64_t base = reinterpret_cast<std::uintptr_t>(info.BaseAddress);
+        const std::uint64_t end = base + info.RegionSize;
+        const std::uint64_t here = static_cast<std::uint64_t>(reinterpret_cast<std::uintptr_t>(address));
+        const std::uint64_t take = std::min<std::uint64_t>(end - here, bytes - at);
+        if (!take) break;
+        const bool usable = info.State == MEM_COMMIT && !(info.Protect & (PAGE_NOACCESS | PAGE_GUARD));
+        if (usable) {
+            std::memcpy(out + at, address, static_cast<std::size_t>(take));
+            copied += take;
+        }
+        at += take;
+    }
+    return copied;
+}
