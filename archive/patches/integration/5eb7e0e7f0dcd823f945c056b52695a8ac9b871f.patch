+constexpr std::uint32_t kPcResourceFlags = 0x3FF;  // D3D12_RESOURCE_FLAG_* up to USE_TIGHT_ALIGNMENT (0x200)
+
+// Device slot 133's address space. The title names its resources by console VA -- an address in the guest's own
+// address space, which this process maps as its own -- and writes to that address directly. Nothing was mapped there
+// (the first fault of the boot was the SRV writer's `0xC0000005` **write** at 0x144dac5fa, ~5.47 GiB), so this commits
+// the range so those writes land in memory. It is not yet the resource's own memory: the buffer behind the resource is
+// the layer's own allocation, so the bytes the title writes here still have to be copied across (a later step), and
+// registering the range as an alias of the resource is what makes that possible.
+struct PlacedVaMapping {
+    std::uint64_t va;      // first byte mapped
+    std::uint64_t size;    // bytes mapped
+};
+std::mutex& placed_va_mutex() {
+    static std::mutex m;
+    return m;
+}
+std::vector<PlacedVaMapping>& placed_va_mappings() {
+    static std::vector<PlacedVaMapping> mappings;
+    return mappings;
+}
+
+// Map [va, va + size) page-aligned with VirtualAlloc2 when that range is free. A range already mapped (the title's own
+// XMem physical pages, or an earlier call that covered it) is left alone: it belongs to whoever mapped it.
+void map_placed_va(std::uint64_t va, std::uint64_t size) {
+    constexpr std::uint64_t kPage = 4096;
+    const std::uint64_t base = va & ~(kPage - 1);
+    const std::uint64_t end = (va + size + kPage - 1) & ~(kPage - 1);
+    if (end <= base) return;
+    const std::size_t bytes = static_cast<std::size_t>(end - base);
+    MEMORY_BASIC_INFORMATION info{};
+    if (VirtualQuery(reinterpret_cast<const void*>(base), &info, sizeof(info)) != 0 &&
+        info.State != MEM_FREE) {
+        // The title keeps this part of its address space itself: the measured first call places a resource in the
+        // 185 MiB placeholder that XMemVirtualAlloc reserved and that XMemMapPhysicalPages fills page by page. Those
+        // pages are the title's own memory, so nothing is mapped here and the placeholder's splits stay intact.
+        static std::atomic<unsigned> noted{0};
+        if (noted.fetch_add(1) < 4)
+            std::fprintf(stderr,
+                         "[rt] d3d12_xs: slot 133 leaves the VA range %llx..%llx alone: the title has it %s\n",
+                         static_cast<unsigned long long>(base), static_cast<unsigned long long>(end),
+                         info.State == MEM_COMMIT ? "committed" : "reserved");
+        return;
+    }
+    using VirtualAlloc2Fn = PVOID(WINAPI*)(HANDLE, PVOID, SIZE_T, ULONG, ULONG, MEM_EXTENDED_PARAMETER*, ULONG);
+    static VirtualAlloc2Fn virtual_alloc2 = [] {
+        HMODULE kernelbase = GetModuleHandleW(L"kernelbase.dll");
+        return kernelbase ? reinterpret_cast<VirtualAlloc2Fn>(GetProcAddress(kernelbase, "VirtualAlloc2")) : nullptr;
+    }();
+    void* mapped = virtual_alloc2
+                       ? virtual_alloc2(nullptr, reinterpret_cast<void*>(base), bytes, MEM_RESERVE | MEM_COMMIT,
+                                        PAGE_READWRITE, nullptr, 0)
+                       : VirtualAlloc(reinterpret_cast<void*>(base), bytes, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+    static std::atomic<unsigned> logged{0};
+    if (!mapped) {
+        if (logged.fetch_add(1) < 4)
+            std::fprintf(stderr,
+                         "[rt] d3d12_xs: slot 133 could not map the VA range %llx..%llx (%lu); the title's writes "
+                         "there still fault\n",
+                         static_cast<unsigned long long>(base), static_cast<unsigned long long>(end), GetLastError());
+        return;
+    }
+    std::memset(mapped, 0, bytes);
+    {
+        const std::lock_guard lock(placed_va_mutex());
+        placed_va_mappings().push_back({base, bytes});
+    }
+    if (logged.fetch_add(1) < 8)
+        std::fprintf(stderr, "[rt] d3d12_xs: slot 133 mapped the console VA range %llx..%llx (%llu bytes)\n",
+                     static_cast<unsigned long long>(base), static_cast<unsigned long long>(end),
+                     static_cast<unsigned long long>(bytes));
