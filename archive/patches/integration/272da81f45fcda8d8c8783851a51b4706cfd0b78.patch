+        EXPECT((xs::list_tail_slot_name(slot, older) != nullptr) == older_tail);
+        EXPECT((xs::list_tail_slot_name(slot, newer) != nullptr) == newer_tail);
+        EXPECT(!xs::list_tail_slot_name(slot, 0));
+        EXPECT(!xs::list_tail_slot_name(slot, 3));
