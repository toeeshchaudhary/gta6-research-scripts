+// The vtable entry the guest calls. Always the shape above; with LEONIDA_XS_TRACE_CALLS it also records the caller
+// and the value, which is the only place the guest's own instruction is still known.
+template <unsigned Slot>
+std::uint64_t WINAPI proxy_slot(DeviceProxy* self, std::uint64_t a1, std::uint64_t a2, std::uint64_t a3,
+                                std::uint64_t a4, std::uint64_t a5, std::uint64_t a6, std::uint64_t a7,
+                                std::uint64_t a8, std::uint64_t a9, std::uint64_t a10, std::uint64_t a11,
+                                std::uint64_t a12, std::uint64_t a13, std::uint64_t a14) {
+    const void* caller = _ReturnAddress();
+    const std::uint64_t result = proxy_slot_impl<Slot>(self, caller, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11,
+                                                       a12, a13, a14);
+    if (call_trace_enabled()) {
+        trace_device_call(Slot, caller, a1, a2, a3, a4, result);
+        if constexpr (Slot == 25 || Slot == 76 || Slot == 108 || Slot == 127 || Slot == 133) trace_dump_state();
+    }
+    return result;
+}
