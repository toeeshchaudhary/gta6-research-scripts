+// LEONIDA_XS_TRACE_CALLS=1: one line per device-slot call carrying the guest return address, the first four
+// arguments and the value that went back. The boot log otherwise only announces a slot's first call, so a null a
+// caller stores cannot be tied to the call that produced it; with this the caller's own instruction is named.
+bool call_trace_enabled() {
+    static const bool enabled = [] {
+        char value[8] = {};
+        const DWORD length = GetEnvironmentVariableA("LEONIDA_XS_TRACE_CALLS", value, sizeof(value));
+        return length > 0 && value[0] != '\0' && value[0] != '0';
+    }();
+    return enabled;
+}
+
+// The guest image is mapped at its `ImageBase` (the loader's trace records base 0x140000000, relocated false), so an
+// RVA is the return address less that base. LEONIDA_XS_TRACE_BASE overrides it for a run that is relocated.
+std::uint64_t guest_image_base() {
+    static const std::uint64_t base = [] {
+        char value[32] = {};
+        const DWORD length = GetEnvironmentVariableA("LEONIDA_XS_TRACE_BASE", value, sizeof(value));
+        if (length > 0) {
+            errno = 0;
+            char* end = nullptr;
+            const std::uint64_t parsed = std::strtoull(value, &end, 0);
+            if (errno == 0 && end != value) return parsed;
+        }
+        return std::uint64_t{0x140000000};
+    }();
+    return base;
+}
+
+void trace_device_call(unsigned slot, const void* caller, std::uint64_t a1, std::uint64_t a2, std::uint64_t a3,
+                       std::uint64_t a4, std::uint64_t result) {
+    const std::uint64_t address = reinterpret_cast<std::uint64_t>(caller);
+    const std::uint64_t base = guest_image_base();
+    std::fprintf(stderr,
+                 "[trace] tid %lu device %u from %#llx (+%#llx) args %#llx %#llx %#llx %#llx -> %#llx\n",
+                 static_cast<unsigned long>(GetCurrentThreadId()), slot, static_cast<unsigned long long>(address),
+                 static_cast<unsigned long long>(address >= base ? address - base : address),
+                 static_cast<unsigned long long>(a1), static_cast<unsigned long long>(a2),
+                 static_cast<unsigned long long>(a3), static_cast<unsigned long long>(a4),
+                 static_cast<unsigned long long>(result));
+}
+
+// LEONIDA_XS_TRACE_CALLS: an allocation query's description and the size/alignment that went back. A caller that
+// turns the answer into an allocation fails later and somewhere else, so the two have to be read together.
+void trace_allocation_answer(unsigned slot, const D3D12_RESOURCE_DESC* desc, std::uint64_t size,
+                             std::uint64_t alignment) {
+    if (!call_trace_enabled() || !desc) return;
+    std::fprintf(stderr,
+                 "[trace] alloc%u dim=%d %llux%u fmt=%u mips=%u array=%u flags=0x%x layout=0x%x -> size=%#llx "
+                 "align=%#llx\n",
+                 slot, int(desc->Dimension), static_cast<unsigned long long>(desc->Width), desc->Height,
+                 unsigned(desc->Format), desc->MipLevels, desc->DepthOrArraySize, unsigned(desc->Flags),
+                 unsigned(desc->Layout), static_cast<unsigned long long>(size),
+                 static_cast<unsigned long long>(alignment));
+}
+
+// LEONIDA_XS_TRACE_DUMP="0x149e1dac0:3,0x14a943ac0:1": guest addresses, and how many 8-byte words of each, printed
+// with every traced device call. The title keeps the state behind a null in its own globals, so the only way to see it
+// is to read it; the addresses are this package's, so the list is an environment variable and not a constant.
+struct TraceDumpWord {
+    std::uint64_t address;
+    unsigned count;
+};
+
+const std::vector<TraceDumpWord>& trace_dump_words() {
+    static const std::vector<TraceDumpWord> words = [] {
+        std::vector<TraceDumpWord> parsed;
+        char value[512] = {};
+        const DWORD length = GetEnvironmentVariableA("LEONIDA_XS_TRACE_DUMP", value, sizeof(value));
+        if (length == 0) return parsed;
+        const char* at = value;
+        while (*at && parsed.size() < 8) {
+            errno = 0;
+            char* end = nullptr;
+            const std::uint64_t address = std::strtoull(at, &end, 0);
+            if (end == at) break;
+            unsigned count = 1;
+            if (*end == ':') {
+                at = end + 1;
+                const unsigned long parsed_count = std::strtoul(at, &end, 0);
+                if (errno == 0 && parsed_count > 0 && parsed_count <= 16) count = static_cast<unsigned>(parsed_count);
+            }
+            parsed.push_back({address, count});
+            while (*end == ',' || *end == ' ') ++end;
+            if (*end == '\0') break;
+            at = end;
+        }
+        return parsed;
+    }();
+    return words;
+}
+
+void trace_dump_state() {
+    const std::vector<TraceDumpWord>& words = trace_dump_words();
+    for (const TraceDumpWord& word : words) {
+        std::fprintf(stderr, "[trace] state[%#llx]:", static_cast<unsigned long long>(word.address));
+        const auto* base = reinterpret_cast<const std::uint64_t*>(static_cast<std::uintptr_t>(word.address));
+        for (unsigned i = 0; i < word.count; ++i)
+            std::fprintf(stderr, " %#llx", static_cast<unsigned long long>(base[i]));
+        std::fprintf(stderr, "\n");
+    }
+}
