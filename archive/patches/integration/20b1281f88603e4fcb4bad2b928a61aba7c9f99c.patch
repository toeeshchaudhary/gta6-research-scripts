+// Device slot 61 is the console's CreateSamplerX(desc, dest). Two things make it worth its own handler rather than the
+// by-number forward: the description is the console's 0x6C-byte form, not D3D12_SAMPLER_DESC, and the console vtable
+// index does not match the PC one (PC slot 61 is CreateMetaCommand, six arguments, so a by-number forward reads a
+// stale stack out-pointer). Console and PC device indices agree only up to about slot 60; past that the console table
+// carries methods the PC one does not.
+//
+// Field offsets are the console layout measured from the console-compiled programs and corroborated by a public slot
+// table (ivall/xcl, GPL-2.0-only, re-derived here rather than copied): address modes at 0x18/0x1C/0x20, LOD 0x24/0x28,
+// bias 0x2C, max anisotropy 0x34, comparison 0x40. The filter is not in the fields identified so far, so samplers are
+// created anisotropic, which is what the title's sampler descriptions ask for in practice.
+// Serve it only for a console caller (see is_console_caller below): a host caller's slot 61 is the PC method. The
+// title was not seen testing a result, so a null description is skipped rather than reported.
+void proxy_create_sampler_x(DeviceProxy* self, const void* console_desc, D3D12_CPU_DESCRIPTOR_HANDLE dest) {
+    note_slot(61);
+    if (!console_desc) return;
+    const auto* p = static_cast<const std::uint8_t*>(console_desc);
+    auto word = [p](std::size_t off) {
+        std::uint32_t value = 0;
+        std::memcpy(&value, p + off, sizeof(value));
+        return value;
+    };
+    auto real32 = [&word](std::size_t off) {
+        const std::uint32_t bits = word(off);
+        float value = 0.0f;
+        std::memcpy(&value, &bits, sizeof(value));
+        return value;
+    };
+    const std::uint32_t anisotropy = word(0x34);
+    D3D12_SAMPLER_DESC desc{};
+    desc.Filter = D3D12_FILTER_ANISOTROPIC;
+    desc.AddressU = static_cast<D3D12_TEXTURE_ADDRESS_MODE>(word(0x18));
+    desc.AddressV = static_cast<D3D12_TEXTURE_ADDRESS_MODE>(word(0x1C));
+    desc.AddressW = static_cast<D3D12_TEXTURE_ADDRESS_MODE>(word(0x20));
+    desc.MipLODBias = real32(0x2C);
+    desc.MaxAnisotropy = anisotropy < 1 ? 1 : (anisotropy > 16 ? 16 : anisotropy);
+    desc.ComparisonFunc = static_cast<D3D12_COMPARISON_FUNC>(word(0x40));
+    desc.BorderColor[0] = 0.0f;
+    desc.BorderColor[1] = 0.0f;
+    desc.BorderColor[2] = 0.0f;
+    desc.BorderColor[3] = 0.0f;
+    desc.MinLOD = real32(0x24);
+    desc.MaxLOD = real32(0x28);
+    self->real->CreateSampler(&desc, translate_cpu_handle(self, dest));
+}
