+// Device slot 61's description as the console writes it: 0x6C bytes, with the fields the layer decodes at the offsets
+// measured from the console-compiled programs (address modes 0x18/0x1C/0x20, LOD range 0x24/0x28, bias 0x2C, max
+// anisotropy 0x34, comparison 0x40). The filter field is not among the identified ones, so it is not set here; the
+// layer creates anisotropic samplers. Every value below is distinct so a swapped offset shows.
+struct ConsoleSamplerDesc {
+    std::uint8_t bytes[0x6C];
+
+    void put(std::size_t off, std::uint32_t value) { std::memcpy(bytes + off, &value, sizeof(value)); }
+    void put(std::size_t off, float value) { std::memcpy(bytes + off, &value, sizeof(value)); }
+
+    ConsoleSamplerDesc() : bytes{} {
+        put(0x18, static_cast<std::uint32_t>(D3D12_TEXTURE_ADDRESS_MODE_MIRROR));   // U
+        put(0x1C, static_cast<std::uint32_t>(D3D12_TEXTURE_ADDRESS_MODE_CLAMP));    // V
+        put(0x20, static_cast<std::uint32_t>(D3D12_TEXTURE_ADDRESS_MODE_BORDER));   // W
+        put(0x24, 1.5f);                                                            // MinLOD
+        put(0x28, 12.0f);                                                           // MaxLOD
+        put(0x2C, 0.25f);                                                           // MipLODBias
+        put(0x34, 8u);                                                              // MaxAnisotropy
+        put(0x40, static_cast<std::uint32_t>(D3D12_COMPARISON_FUNC_LESS_EQUAL));
+    }
+};
+
+// The decoded D3D12_SAMPLER_DESC a mock slot 22 call received, checked field by field.
+bool sampler_matches_console(const D3D12_SAMPLER_DESC* desc) {
+    return desc && desc->Filter == D3D12_FILTER_ANISOTROPIC && desc->AddressU == D3D12_TEXTURE_ADDRESS_MODE_MIRROR &&
+           desc->AddressV == D3D12_TEXTURE_ADDRESS_MODE_CLAMP && desc->AddressW == D3D12_TEXTURE_ADDRESS_MODE_BORDER &&
+           desc->MipLODBias == 0.25f && desc->MaxAnisotropy == 8 &&
+           desc->ComparisonFunc == D3D12_COMPARISON_FUNC_LESS_EQUAL && desc->MinLOD == 1.5f && desc->MaxLOD == 12.0f &&
+           desc->BorderColor[0] == 0.0f && desc->BorderColor[1] == 0.0f && desc->BorderColor[2] == 0.0f &&
+           desc->BorderColor[3] == 0.0f;
+}
